# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environment variables & secrets
.env
.env.*
*.pem
*.key

# Virtual environments
venv/
.venv/
env/
ENV/

# Python packaging & builds
dist/
build/
*.egg-info/

# AppSail: ignore all installed third-party libraries except our app code
appsail-python/*
!appsail-python/app.py
!appsail-python/app-config.json
!appsail-python/forecast.py
!appsail-python/predict.py
!appsail-python/switching.py
!appsail-python/requirements.txt
!appsail-python/train_prepared.csv
!appsail-python/static/
!appsail-python/static/**

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
